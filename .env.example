# Variáveis do painel do Nexo. Copie para .env (ou .env.local) e ajuste. Todas são opcionais em desenvolvimento.

# Endereço da API (backend). Padrão: http://localhost:3000/api
# Se o backend rodar em outra porta (ex.: PORT=3100), use http://localhost:3100/api
VITE_API_URL="http://localhost:3000/api"

# Endereço do site institucional, usado no selo "feito com Nexo" das páginas publicadas.
# Padrão: https://nexo.app
VITE_SITE_URL="https://nexo.app"
